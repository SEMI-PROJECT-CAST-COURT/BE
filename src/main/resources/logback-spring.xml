<?xml version="1.0" encoding="UTF-8"?>
<!-- logback-spring.xml : 스프링이 읽어 주므로 springProfile 태그를 쓸 수 있다 (logback.xml 이면 못 씀) -->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_DIR" value="logs"/>

    <property name="CONSOLE_PATTERN"
              value="%d{HH:mm:ss.SSS} %clr(%-5level) %clr(%logger{36}){cyan} - %msg%n"/>

    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 전체 로그 : 날짜가 바뀌거나 10MB 를 넘으면 새 파일 · 30일 · 전체 1GB 까지 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/cast-court.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/cast-court.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- WARN 이상만 · 90일 · 전체 500MB 까지 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/cast-court-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/cast-court-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- AI 사용량 (global/infra/log 의 AiUsage · TrialAiUsage · DraftAiUsage Aspect) 만 따로 · 비용 집계용이라 90일 보관 -->
    <appender name="AI_USAGE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/ai-usage.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/ai-usage.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- AI 사용량 : 전용 파일에도 남기고, additivity 기본값(true)이라 root 의 콘솔 · 전체 파일에도 남는다 -->
    <logger name="com.verdict.castcourt.global.infra.log">
        <appender-ref ref="AI_USAGE_FILE"/>
    </logger>

    <!-- SQL · 바인딩 값은 양이 많고 민감한 값이 섞여서 파일에는 남기지 않는다 (레벨은 application.yaml) -->
    <!-- 개발 : 콘솔 + 파일 (SQL 은 콘솔만) -->
    <springProfile name="!prod">
        <logger name="org.hibernate.SQL" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.hibernate.orm.jdbc.bind" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>

    <!-- 운영 : 콘솔은 동기 출력이라 느려질 수 있어 파일만 (SQL 은 어디에도 남기지 않음) -->
    <springProfile name="prod">
        <logger name="org.hibernate.SQL" additivity="false"/>
        <logger name="org.hibernate.orm.jdbc.bind" additivity="false"/>

        <root level="INFO">
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>

</configuration>
